# ==============================================================================
# CareerOS Environment Configuration Template (.env.example)
# DO NOT COMMIT REAL CREDENTIALS, TOKENS, OR PRIVATE RESUMES TO VERSION CONTROL.
# ==============================================================================

# Database Connection (PostgreSQL)
# Local Docker instance: postgresql://careeros:careeros@localhost:5432/careeros?schema=public
DATABASE_URL="postgresql://careeros:careeros@localhost:5432/careeros?schema=public"

# Application Mode
NODE_ENV="development"
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_DEMO_MODE="true"

# Secret Encryption Key (Must be exactly 32 bytes / 64 hex characters for AES-256-GCM token encryption)
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Single-User Authentication Secret
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-development-auth-secret-min-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# Operational Rate Limits & Safety Ceilings
MAX_DAILY_OUTREACH_DRAFTS="5"
MAX_WEEKLY_OUTREACH="20"
APPROVAL_TOKEN_TTL_MINUTES="30"

# GitHub App / OAuth Integration (Starts Read-Only; Write requires explicit approval)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:3000/api/auth/callback/github"
GITHUB_TOKEN="" # Optional fine-grained PAT (read:user, public_repo) for read-only access

# Google Workspace / Gmail OAuth Integration (Draft-only first; Send requires explicit confirmation)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# Optional LinkedIn Official Developer API (Manual copy handoff is used when unavailable)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/auth/callback/linkedin"

# Optional AI Provider Keys (Provider-neutral; mock mode is used when unset)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
